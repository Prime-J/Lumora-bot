# MongoDB Atlas or Railway MongoDB connection string
# Railway auto-sets this when you add MongoDB database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lumora-bot?retryWrites=true&w=majority

# If using Railway's native MongoDB, the URI will be auto-injected
# You can check it in Railway dashboard under Environment

# Anthropic API key for Star (the AI companion)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── LOGIN — link this bot to WhatsApp ────────────────────────────────
# With a number set (while the session is NOT registered yet), the bot asks
# WhatsApp for an 8-character pairing code instead of printing a QR code.
# On the phone: WhatsApp → Settings → Linked Devices → Link a Device →
# "Link with phone number instead" → type the code.
# Digits only, country code included, no plus sign.
PAIRING_NUMBER=2348101234567

# Country code for the number above. WhatsApp wants the INTERNATIONAL form
# (2348083028530) while people usually type the local one (08083028530).
# With this set, the leading 0 is replaced automatically; without it the bot
# asks for the country code whenever it sees a leading 0.
LUMORA_COUNTRY_CODE=234

# Set to "qr" to force the old scan-the-QR-code flow even when a number is set.
# LUMORA_LOGIN=qr

# ── CARD BRIDGE (can a tap inside an in-chat card reach the bot?) ────────
# Public HTTPS URL of the bridge — a Cloudflare tunnel or ngrok pointing at
# LUMORA_BRIDGE_PORT. Cards use it to send taps back; without it every card
# simply falls back to showing the command to type.
LUMORA_BRIDGE_URL=

# Port the bridge listens on (127.0.0.1 by default; set LUMORA_BRIDGE_HOST to widen it).
LUMORA_BRIDGE_PORT=8791

# HMAC secret used to sign card tokens. Generated once into
# data/bridge_secret.json when unset. Never hand this to a card.
LUMORA_BRIDGE_SECRET=

# Set to "off" to disable the bridge entirely (cards then show commands only).
# LUMORA_BRIDGE=off
